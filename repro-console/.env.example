# --- Storage (required on Vercel) -------------------------------------------
# Add "Upstash for Redis" from the Vercel Marketplace; it sets these for you.
# Either naming scheme works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Dashboard sign-in -------------------------------------------------------
# Leave both passwords empty to run with sign-in OFF (local dev only).
REPRO_VIEWER_PASSWORD=
REPRO_APPROVER_PASSWORD=
# Required when any password is set. Generate: openssl rand -hex 32
REPRO_SESSION_SECRET=

# --- Customer intake (server-side Gemini generation) ------------------------
# Set this in .env.local for development and as a server environment variable
# in production. Never prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Defaults to gemini-3.6-flash. Use a model available to your Gemini project.
PATCH_CUSTOMER_MODEL=gemini-3.6-flash

# --- Live investigation runner --------------------------------------------
# Run the long-lived worker beside the console locally. A hosted console needs
# a reachable private/authenticated runner URL instead of localhost.
PATCH_RUNTIME_URL=http://127.0.0.1:4318
# Shared only by the console server and runner. Generate: openssl rand -hex 32
PATCH_RUNTIME_TOKEN=
REPRO_CONSOLE_URL=http://127.0.0.1:3000
# The worker can also use the first token in REPRO_INGEST_TOKENS below.
REPRO_INGEST_TOKEN=
# Optional: must match the selected REPRO_INGEST_TOKENS workspace.
PATCH_RUNTIME_WORKSPACE=

# Claude Code must be installed and authenticated on the worker machine.
PATCH_CLAUDE_COMMAND=claude
PATCH_EXECUTION_MODEL=opus
PATCH_SUPERVISOR_MODEL=gemini-3.6-flash
PATCH_INCIDENTS_MODEL=gemini-3.6-flash

# Optional source-fix adapter for the included booking app only.
# Point to the absolute Patch repository root, not the booking-app subfolder.
PATCH_FIX_BOOKING_APP=0
PATCH_FIX_REPO_PATH=
PATCH_BOOKING_APP_URL=http://127.0.0.1:3100

# Cloud sessions require both values. Explicit local Chromium remains available
# for investigating the included app at http://127.0.0.1:3100.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# --- Agent runtime credentials ----------------------------------------------
# workspace:token pairs, comma separated. Each token can only write to runs
# in its own workspace. Generate tokens: openssl rand -hex 24
REPRO_INGEST_TOKENS=acme:replace-me

# --- Agent runtime only (set these where the worker runs, NOT in Vercel) -----
# REPRO_CONSOLE_URL=https://your-app.vercel.app
# REPRO_INGEST_TOKEN=
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
# TARGET=https://booking-app-preview.vercel.app
# SANDBOX_ADMIN=            # must match the booking app's SANDBOX_ADMIN, or reset() 401s
# GEMINI_API_KEY=            # optional: support-engineer uses direct Gemini when set
